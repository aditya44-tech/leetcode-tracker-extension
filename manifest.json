{
  "manifest_version": 3,
  "name": "LeetCode Tracker",
  "version": "1.1.0",
  "description": "Tracks difficulty and solve time for LeetCode problems.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "LeetCode Tracker"
  },
  "web_accessible_resources": [
    {
      "resources": ["logos/*.svg", "companyData.json", "companyData.js", "problemMeta.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
